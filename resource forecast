damped_results <- hotel_state %>%
  group_by(State) %>%
  arrange(Year) %>%
  group_modify(~ {
    
    train_state <- .x %>%
      filter(Year <= 2022)
    
    test_state <- .x %>%
      filter(Year >= 2023)
    
    model <- holt(
      train_state$Hotel_Guests,
      h = nrow(test_state),
      damped = TRUE
    )
    
    tibble(
      Year = test_state$Year,
      Actual = test_state$Hotel_Guests,
      Predicted = as.numeric(model$mean)
    )
  }) %>%
  ungroup()
damped_rmse <- sqrt(
  mean((damped_results$Actual -
          damped_results$Predicted)^2)
)

damped_mae <- mean(
  abs(damped_results$Actual -
        damped_results$Predicted)
)

damped_rmse
damped_mae

