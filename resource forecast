# -----------------------------
# ELECTRICITY VALIDATION
# -----------------------------

electricity_total <- energy_state %>%
  group_by(Year) %>%
  summarise(
    Electricity = sum(Electricity, na.rm = TRUE)
  ) %>%
  arrange(Year)

# Training: up to 2023
electricity_train <- electricity_total %>%
  filter(Year <= 2023)

# Test: 2024-2025
electricity_test <- electricity_total %>%
  filter(Year >= 2024)

y_train <- ts(
  electricity_train$Electricity,
  start = min(electricity_train$Year),
  frequency = 1
)

# Models
electricity_naive <- naive(y_train, h = 2)
electricity_drift <- rwf(y_train, h = 2, drift = TRUE)
electricity_ets <- forecast(ets(y_train), h = 2)
electricity_arima <- forecast(auto.arima(y_train), h = 2)

actual_electricity <- electricity_test$Electricity

# RMSE
electricity_rmse <- c(
  Naive = sqrt(mean((electricity_naive$mean - actual_electricity)^2)),
  Drift = sqrt(mean((electricity_drift$mean - actual_electricity)^2)),
  ETS = sqrt(mean((electricity_ets$mean - actual_electricity)^2)),
  ARIMA = sqrt(mean((electricity_arima$mean - actual_electricity)^2))
)

# MAE
electricity_mae <- c(
  Naive = mean(abs(electricity_naive$mean - actual_electricity)),
  Drift = mean(abs(electricity_drift$mean - actual_electricity)),
  ETS = mean(abs(electricity_ets$mean - actual_electricity)),
  ARIMA = mean(abs(electricity_arima$mean - actual_electricity))
)

electricity_rmse
electricity_mae

