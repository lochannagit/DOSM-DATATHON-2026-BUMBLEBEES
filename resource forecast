#1 load library
library(readxl)
library(dplyr)
library(tidyr)
library(glmnet)
library(forecast)
library(ggplot2)

#2 load hotel guest data
hotel <- read_excel("C:/Users/locha/OneDrive/Desktop/DOSM DATATHON/totalhotelguests.xlsx")
str(hotel)

#3 reshape annual data 
hotel_state <- hotel %>%
  filter(State != "Malaysia") %>%
  pivot_longer(
    cols = `2017`:`2025`,
    names_to = "Year",
    values_to = "Hotel_Guests"
  ) %>%
  mutate(
    Year = as.integer(Year)
  ) %>%
  arrange(State, Year)
head(hotel_state)
dim(hotel_state)

#4 create modelling features
hotel_features <- hotel_state %>%
  group_by(State) %>%
  arrange(Year) %>%
  mutate(
    Lag1 = lag(Hotel_Guests, 1),
    Lag2 = lag(Hotel_Guests, 2),
    Growth_1Y = (Hotel_Guests / Lag1) - 1
  ) %>%
  ungroup()
head(hotel_features, 10)

#5 time based validation
train <- hotel_features %>%
  filter(Year <= 2022) %>%
  filter(!is.na(Lag1), !is.na(Lag2))

test <- hotel_features %>%
  filter(Year >= 2023) %>%
  filter(!is.na(Lag1), !is.na(Lag2))
dim(train)
dim(test)

#6 prepare model matrix
x_train <- model.matrix(
  Hotel_Guests ~ Lag1 + Lag2 + Growth_1Y + Year + State,
  data = train
)[, -1]

y_train <- train$Hotel_Guests

x_test <- model.matrix(
  Hotel_Guests ~ Lag1 + Lag2 + Growth_1Y + Year + State,
  data = test
)[, -1]

y_test <- test$Hotel_Guests
dim(x_train)
dim(x_test)

#7 train, predict, calculate ridge model
set.seed(123)

ridge_model <- cv.glmnet(
  x_train,
  y_train,
  alpha = 0,
  family = "gaussian",
  standardize = TRUE
)

ridge_pred <- predict(
  ridge_model,
  newx = x_test,
  s = "lambda.min"
)[, 1]

ridge_rmse <- sqrt(mean((y_test - ridge_pred)^2))
ridge_mae <- mean(abs(y_test - ridge_pred))

ridge_rmse
ridge_mae

#8 test a pooled elastic net model
set.seed(123)

elastic_model <- cv.glmnet(
  x_train,
  y_train,
  alpha = 0.5,
  family = "gaussian",
  standardize = TRUE
)
elastic_pred <- predict(
  elastic_model,
  newx = x_test,
  s = "lambda.min"
)[, 1]
elastic_rmse <- sqrt(mean((y_test - elastic_pred)^2))
elastic_mae <- mean(abs(y_test - elastic_pred))

elastic_rmse
elastic_mae

#9 test with naive benchmark
naive_pred <- test$Lag1
naive_rmse <- sqrt(mean((y_test - naive_pred)^2))
naive_mae <- mean(abs(y_test - naive_pred))

naive_rmse
naive_mae

#10 test state specifc trend model
trend_model <- lm(
