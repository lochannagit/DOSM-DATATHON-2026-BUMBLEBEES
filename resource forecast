# 17 create resource pressure
profile_2024 <- profile_2024 %>%
  mutate(
    Electricity_Pressure = (
      Electricity - min(Electricity, na.rm = TRUE)
    ) / (
      max(Electricity, na.rm = TRUE) -
        min(Electricity, na.rm = TRUE)
    ),
    
    Waste_Pressure = (
      `Estimated Waste Per Year (kg)` -
        min(`Estimated Waste Per Year (kg)`, na.rm = TRUE)
    ) / (
      max(`Estimated Waste Per Year (kg)`, na.rm = TRUE) -
        min(`Estimated Waste Per Year (kg)`, na.rm = TRUE)
    ),
    
    Resource_Pressure = (
      Electricity_Pressure +
        Waste_Pressure
    ) / 2
  )

#18 prepare ml data
ml_data <- profile_2024 %>%
  filter(
    !is.na(Tourism_Intensity),
    !is.na(Resource_Pressure)
  ) %>%
  select(
    State,
    Tourism_Intensity,
    Resource_Pressure
  )
ml_scaled <- scale(
  ml_data %>%
    select(
      Tourism_Intensity,
      Resource_Pressure
    )
)

